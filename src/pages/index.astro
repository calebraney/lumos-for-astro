---
import Layout from '@/layouts/BaseLayout.astro';
import Section from '@/components/Section.astro';
import Heading from '@/components/Heading.astro';
import Eyebrow from '@/components/Eyebrow.astro';
import logo from '@/assets/logo.svg';
import arrow_full from '@/assets/icons/arrow-full.svg';
import arrow from '@/assets/icons/arrow.svg';
import close from '@/assets/icons/close.svg';
import pause from '@/assets/icons/pause.svg';
import play from '@/assets/icons/play.svg';
import lumos_background from '@/assets/lumos-background.svg';
import Icon from '@/components/Icon.astro';
import logo_icon from '@/assets/logo-icon.svg';
import ContentWrapper from '@/components/ContentWrapper.astro';
---
<Layout theme="dark">
  <Section paddingBottom="even" containerClass="flex-grow" paddingTop="even" class="flex-grow" style="min-height: calc(100svh - var(--nav-height));">
    <ContentWrapper variant="card" class="theme-brand" style="min-height: 80vh;">
      <div class="padding-large">
      </div>
      <Icon src={logo_icon} variant="large" />
      <Heading variant="display" class="margin-block-8" tag="h1">Style Guide</Heading>
      <Eyebrow>v0.01</Eyebrow>
      <div class="padding-large">
      </div>
    </ContentWrapper>
  </Section>
</Layout>
